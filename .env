# ─────────────────────────────────────────────────────────────
#  Python Mastery — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string
# Get it from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT signing secret — change this to a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret

# Optional: protect the one-time admin setup endpoint
# If set, /api/admin/setup requires this key in the request body
ADMIN_SETUP_KEY=

# Flask port (default: 5000)
PORT=5000
